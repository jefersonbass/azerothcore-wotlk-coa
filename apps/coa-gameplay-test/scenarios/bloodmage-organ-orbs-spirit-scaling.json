{
  "schema": 1,
  "name": "Bloodmage #605 Organ Orbs: Spirit scales with Pooled Vitality stacks",
  "contract": "Organ Orbs (807490) raises Spirit by 3% per Pooled Vitality (680687) stack, refreshed on stack changes.",
  "timeout_ms": 90000,
  "players": [
    { "id": "bloodmage", "race": 1, "class": 20, "level": 80 }
  ],
  "steps": [
    { "action": "wait", "ms": 5000 },
    { "action": "set_aura", "actor": "bloodmage", "spell": 807490, "stacks": 1 },
    { "action": "assert", "actor": "bloodmage", "metric": "aura", "spell": 807490, "equals": 1 },
    { "action": "snapshot", "actor": "bloodmage", "metric": "stat", "stat": 4, "save_as": "spirit_no_pool" },
    { "action": "set_aura", "actor": "bloodmage", "spell": 680687, "stacks": 3 },
    { "action": "assert", "actor": "bloodmage", "metric": "aura_stacks", "spell": 680687, "equals": 3, "within_ms": 2000 },
    {
      "action": "assert", "label": "3 Pooled Vitality stacks raise Spirit via Organ Orbs",
      "actor": "bloodmage", "metric": "stat", "stat": 4, "relative_to": "spirit_no_pool", "min": 1, "within_ms": 3000
    },
    { "action": "set_aura", "actor": "bloodmage", "spell": 680687, "stacks": 0 },
    {
      "action": "assert", "label": "Dropping the pool returns Spirit to baseline",
      "actor": "bloodmage", "metric": "stat", "stat": 4, "relative_to": "spirit_no_pool", "equals": 0, "within_ms": 3000
    }
  ]
}
